# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# OpenAI — used for GPT Image generation
OPENAI_API_KEY=

# Anthropic — used for the creative-director analysis and prompt compiling
ANTHROPIC_API_KEY=

# Future providers (leave blank until you have keys — the model router
# only offers models whose keys are present)
BFL_API_KEY=
IDEOGRAM_API_KEY=

# Google sign-in, restricted to @hightouch.io. Create a Web application OAuth
# client at https://console.cloud.google.com/apis/credentials and authorize the
# site's origin. No client secret needed. Without these, the app fails closed.
GOOGLE_CLIENT_ID=
SESSION_SECRET=

# Local development only — 1 skips sign-in. Never set this on the deployment.
AUTH_DEV_BYPASS=0
